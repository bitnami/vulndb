{
  "schema_version": "1.6.2",
  "id": "BIT-mysql-client-2026-85748",
  "summary": "MariaDB: Use-after-free with a large number of SYS_REFCURSOR's",
  "details": "MariaDB server is a community developed fork of MySQL server. From 12.3.1 until 12.3.3 and 13.0.2, SYS_REFCURSOR handling is affected because cursor-array reallocation can leave stale references in routine contexts. A low-privileged attacker can open a large number of SYS_REFCURSORs and then fetch one to trigger a use-after-free that can enable remote code execution when combined with another vulnerability. This issue is fixed in versions 12.3.3 and 13.0.2.",
  "aliases": [
    "CVE-2026-85748"
  ],
