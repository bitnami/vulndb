{
  "schema_version": "1.6.2",
  "id": "BIT-mysql-client-2026-102523",
  "summary": "MariaDB server: Authorization bypass via ALTER TABLE ... CONVERT ... PARTITION",
  "details": "MariaDB server is a community developed fork of MySQL server. From 10.11.1 until 10.11.19, 11.4.13, 11.8.9, 12.3.3, and 13.0.2, ALTER TABLE ... CONVERT ... PARTITION does not apply filename encoding to user-specified partition names before using them in filesystem path construction. An authenticated database user can use a partition name requiring filename escaping to make the conversion operate on table files the user is not authorized to access, allowing unauthorized table reads or modifications. This issue is fixed in versions 10.11.19, 11.4.13, 11.8.9, 12.3.3, and 13.0.2.",
  "aliases": [
    "CVE-2026-102523"
