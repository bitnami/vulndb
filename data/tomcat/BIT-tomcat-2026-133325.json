{
  "schema_version": "1.6.2",
  "id": "BIT-tomcat-2026-133325",
  "summary": "Apache Tomcat: Cluster TLS-PSK configured to use TLS 1.3 does not validate peer",
  "details": "Key exchange without entity authentication vulnerability in Apache Tomcat allowed an unauthenticated node to join a cluster when the cluster was secured with TLS 1.3 and TLS-PSK.\n\n\n\nThis issue affects Apache Tomcat: 11.0.28-11.0.29, 10.1.62, 9.0.124.\n\n\n\nUsers are recommended to switch to TLS 1.2 and TLS-PSK or upgrade to version 11.0.30, 10.1.63 or 9.0.125 (when released), which fix the issue.",
  "aliases": [
    "CVE-2026-133325"
  ],
